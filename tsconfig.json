{
  // Everything that must NOT see Office.js: core, ui, app (except the entry that starts the
  // Office host), dev panes that do not register adapters, tests and tool configs.
  // Office types are only available in tsconfig.adapters.json (Constitution I).
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node", "vite/client"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "*.config.ts"],
  "exclude": [
    "src/adapters/**",
    "src/app/main.ts",
    "src/dev/contract-pane.ts",
    "src/dev/perf-pane.ts",
    "node_modules",
    "dist",
    "dist-dev"
  ],
  "references": [{ "path": "./tsconfig.adapters.json" }]
}
