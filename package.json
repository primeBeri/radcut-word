{
  "name": "radcut-word",
  "version": "0.1.0",
  "private": true,
  "description": "RAD·CUT: a keyboard palette for inserting native heading cross-references in Word",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "certs": "office-addin-dev-certs install",
    "dev-server": "vite",
    "start": "node scripts/office-debug.mjs start desktop --app word --dev-server \"npm run dev-server\" --dev-server-port 3000",
    "start:dev-pane": "node scripts/office-debug.mjs start desktop --app word --dev-server \"vite --mode devpane\" --dev-server-port 3000",
    "stop": "node scripts/office-debug.mjs stop",
    "build": "node scripts/build-tokens.mjs && vite build && node scripts/check-bundle-size.mjs",
    "build:dev-pane": "node scripts/build-tokens.mjs && vite build --mode devpane",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "bench": "vitest bench --run",
    "test:desktop": "dotnet test --solution tests/desktop/RadCut.DesktopTests.slnx --results-directory tests/desktop/test-results --report-xunit-trx --report-xunit-junit",
    "lint": "eslint .",
    "typecheck": "tsc -b && svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "svelte": "^5.57.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fluentui/tokens": "^1.0.0-alpha.24",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.6.5",
    "@types/office-js": "^1.0.611",
    "@types/office-runtime": "^1.0.40",
    "eslint": "^10.12.0",
    "eslint-plugin-svelte": "^3.23.1",
    "fuzzysort": "^4.0.2",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "office-addin-debugging": "^7.0.1",
    "office-addin-dev-certs": "^3.0.1",
    "svelte-check": "^4.7.6",
    "svelte-eslint-parser": "^1.9.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
